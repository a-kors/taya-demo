---
import { master } from '../data/master';
import CtaGroup from './CtaGroup.astro';
---

<!--
  Финал: FAQ выше и этот блок на одном фоне (--bg-soft), в конце экран целиком уходит в цвет сферы (--warm),
  футер уже этого цвета. Крупная фраза и кнопка прилипают по центру,
  снизу поднимается мягкое тёплое свечение и растекается в том числе под FAQ и под футер (их содержимое
  поднято над сферой). Всё привязано к прокрутке (src/scripts/motion.ts), при «уменьшить движение» сразу конечное состояние.
-->
<section class="sun-ft" aria-labelledby="final-h">
  <div class="sun-scene">
    <div class="sun-stick">
      <div class="sun-clip" aria-hidden="true"><div class="sun-ball"></div></div>
      <div class="sun-copy wrap">
        <span class="sun-eyebrow">Запись на&nbsp;диагностику</span>
        <h2 id="final-h" class="fs-h" data-words>Расскажите, что&nbsp;беспокоит,<br />и&nbsp;мы подберём формат для&nbsp;вашего ребёнка.</h2>
        
        <div class="sun-actions">
          <CtaGroup label="Записаться в Telegram" variant="primary" />
          <p class="sun-phone">или позвонить: <a href={master.phoneHref}>{master.phone}</a>, <a href={master.phone2Href}>{master.phone2}</a></p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .sun-ft {
    /* цвет, в который уходит экран: центр сферы поверх фона */
    --warm: #bfded1;
    padding: 0;
    background: var(--bg-soft);
  }
  /* содержимое соседей (блок перед финалом и футер) поверх свечения, их фон под ним */
  :global(section:has(+ .sun-ft) > *),
  :global(footer > *) {
    position: relative;
    z-index: 1;
  }

  /* высокая сцена: экран прилипшей сцены + полтора экрана прокрутки на анимацию */
  .sun-scene {
    position: relative;
    height: 250vh;
  }
  .sun-stick {
    position: sticky;
    top: 0;
    height: 100vh;
    display: grid;
    place-items: center;
  }
  /* слой свечения шире экрана сцены: вверх на высоту блока перед финалом, вниз на высоту футера
     (--up, --down ставит motion.ts); overflow обрезает сферу, чтобы не было прокрутки вбок */
  .sun-clip {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(-1px * var(--up, 0));
    bottom: calc(-1px * var(--down, 0));
    overflow: hidden;
    pointer-events: none;
  }
  /* в конце весь слой (экран, и под футером тоже) поверх сферы становится её цветом: экран меняет цвет */
  .sun-clip::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--warm);
    opacity: var(--fill, 0);
  }

  /* сфера: огромный круг с мягким радиальным градиентом без края, тёплый абрикос с розовым краем */
  .sun-ball {
    position: absolute;
    left: 50%;
    top: calc(var(--up, 0) * 1px + 50vh);
    width: 200vmax;
    height: 200vmax;
    margin: -100vmax 0 0 -100vmax;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      rgba(140, 206, 190, 0.5) 0%,
      rgba(150, 210, 196, 0.45) 16%,
      rgba(166, 216, 203, 0.37) 32%,
      rgba(184, 222, 211, 0.28) 48%,
      rgba(202, 228, 218, 0.18) 64%,
      rgba(220, 232, 224, 0.08) 80%,
      rgba(242, 238, 228, 0) 100%
    );
    transform: translateY(calc(42vh * (1 - var(--sb, 0)))) scale(calc(0.5 + 1.6 * var(--sg, 0)));
    opacity: min(1, calc(var(--sb, 0) * 5));
    will-change: transform;
  }

  .sun-copy {
    position: relative;
    z-index: 1;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .sun-eyebrow {
    font-size: 12.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--ink) 76%, var(--warm)); /* читается и на фоне, и на итоговой заливке */
    margin-bottom: 28px;
  }
  .fs-h {
    margin: 0 0 40px; /* подзаголовка нет, отступ до кнопок как у Мерца */
    font-size: clamp(34px, 4.2vw, 60px); /* фраза длиннее, чем у Мерца: вторая строка целиком на широком экране */
    line-height: 1.08;
    text-wrap: balance;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  /* каждое слово: из размытого, прозрачного и чуть ниже в резкое на месте; --wp от 0 до 1 */
  .fs-h :global(.w) {
    display: inline-block;
    vertical-align: bottom;
    padding: 0 0.03em 0.08em;
  }
  .fs-h :global(.w i) {
    display: inline-block;
    font-style: normal;
    transform: translateY(calc(28% * (1 - var(--wp, 1))));
    filter: blur(calc(16px * (1 - var(--wp, 1))));
    opacity: var(--wp, 1);
  }
  .fs-h :global(.w.l2 i) {
    font-style: italic;
    color: var(--accent);
  }
  .sun-sub {
    font-family: var(--font-serif);
    font-size: clamp(18px, 1.8vw, 22px);
    color: color-mix(in srgb, var(--ink) 76%, var(--warm)); /* читается и на фоне, и на итоговой заливке */
    margin-bottom: 40px;
  }
  .sun-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }
  .sun-actions :global(.cta-group__main) {
    padding: 20px 38px;
    font-size: 17px;
    box-shadow: 0 26px 50px -24px rgba(47, 127, 115, 0.45);
  }
  .sun-actions :global(.cta-group__social) {
    width: 56px;
    height: 56px;
    background: rgba(255, 255, 255, 0.55);
  }
  .sun-phone {
    font-size: 14px;
    color: color-mix(in srgb, var(--ink) 76%, var(--warm)); /* читается и на фоне, и на итоговой заливке */
    transition: color 0.2s;
  }
  .sun-phone a {
    white-space: nowrap;
  }
  .sun-phone a:hover {
    color: var(--accent);
  }

  @media (max-width: 760px) {
    .sun-scene {
      height: 200vh;
    }
  }
  @media (max-width: 480px) {
    .sun-actions :global(.cta-group) {
      justify-content: center;
    }
    .sun-actions :global(.cta-group__main) {
      padding: 18px 26px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .fs-h :global(.w i) {
      transform: none !important;
      filter: none !important;
    }
  }
</style>

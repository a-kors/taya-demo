---
import { master } from '../data/master';

interface Props {
  label?: string;
  variant?: 'primary' | 'secondary';
  tone?: 'default' | 'dark';
  size?: 'md' | 'sm';
}

const {
  label = 'Записаться в Telegram',
  variant = 'primary',
  tone = 'default',
  size = 'md',
} = Astro.props;
---

<div class={`cta-group cta-group--${tone} cta-group--${size}`}>
  <a class={`btn btn-${variant} cta-group__main`} href={master.telegram}>
    <span>{label}</span>
    <span class="arrow" aria-hidden="true">→</span>
  </a>

  <a class="cta-group__social" href={master.whatsapp} aria-label="Написать в WhatsApp" title="WhatsApp">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M3.5 20.5 4.8 16A8.5 8.5 0 1 1 8 19.2l-4.5 1.3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
      <path d="M9 8.6c.2-.5.5-.6.8-.6h.5c.2 0 .4.1.5.4l.7 1.6c.1.3 0 .5-.1.7l-.5.6c.6 1.2 1.6 2.2 2.8 2.8l.6-.5c.2-.2.4-.2.7-.1l1.6.7c.3.1.4.3.4.5v.5c0 .3-.1.6-.6.8-.6.3-1.6.4-3-.2a8.6 8.6 0 0 1-4.3-4.3c-.6-1.4-.5-2.4-.2-3Z" fill="currentColor"/>
    </svg>
  </a>

  <a class="cta-group__social" href={master.vk} aria-label="Написать в ВКонтакте" title="ВКонтакте">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M3.5 7h3c0.5 3 1.7 5.7 3.5 7v-7h3v3c0 0.9 0.5 1.3 1 1.3 0.5 0 1-0.4 1.3-1C15.7 9 16.5 7.6 17 7h3c-0.6 2-2.2 4.4-3.3 5.5-0.3 0.3-0.3 0.5 0 0.9 0.5 0.5 2.5 2.9 3 4.1 0.2 0.5-0.1 0.8-0.6 0.8H16c-0.5 0-0.9-0.2-1.3-0.6-0.9-0.9-1.7-2.2-2.5-2.2-0.3 0-0.5 0.2-0.5 0.8V17c0 0.6-0.3 1-1.5 1-3 0-6-2-8.1-6.3C1 10 1 7.5 3.5 7Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
    </svg>
  </a>
</div>

<style>
  .cta-group {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
  .cta-group__social {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line-strong);
    color: var(--ink);
    background: #ffffff;
    transition: color 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
    text-decoration: none;
    flex-shrink: 0;
  }
  .cta-group__social:hover {
    color: var(--accent);
    border-color: var(--accent);
    transform: translateY(-1px);
  }

  .cta-group--sm .cta-group__social {
    width: 36px;
    height: 36px;
  }
  .cta-group--sm .cta-group__social svg {
    width: 15px;
    height: 15px;
  }

  .cta-group--dark .cta-group__main {
    background: var(--accent);
    color: #ffffff;
  }
  .cta-group--dark .cta-group__main:hover {
    background: var(--accent-hover);
  }
  .cta-group--dark .cta-group__social {
    background: transparent;
    border-color: rgba(255, 255, 255, 0.2);
    color: rgba(255, 255, 255, 0.85);
  }
  .cta-group--dark .cta-group__social:hover {
    color: #ffffff;
    border-color: #ffffff;
  }
  @media (max-width: 440px) {
    .cta-group {
      width: 100%;
    }
    .cta-group__main {
      flex: 1 1 100%;
      justify-content: center;
    }
  }
  @media (max-width: 480px) {
    .cta-group {
      width: 100%;
    }
    .cta-group__main {
      flex-basis: 100%;
      justify-content: center;
    }
  }
</style>

---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { master, gallery } from '../data/master';

const imgs = import.meta.glob<{ default: ImageMetadata }>('/src/assets/gallery/*.jpg', { eager: true });
const items = Object.entries(imgs)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, mod], i) => ({ img: mod.default, cap: gallery[i] ?? '' }));
---

<section id="gallery" class="gl">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <span class="section-eyebrow">Наши занятия</span>
      <h2>Как это выглядит в&nbsp;студии.</h2>
      <p>
        Фото с&nbsp;занятий и&nbsp;пособия из&nbsp;альбомов студии.
        Подписи студии.
      </p>
    </header>

    <div class="gl__cols">
      {items.map((it, i) => (
        <figure class="gi" data-reveal data-reveal-delay={Math.min((i % 3) * 80, 240)}>
          <Image
            src={it.img}
            alt={it.cap}
            widths={[360, 560, 760]}
            sizes="(max-width: 560px) 92vw, (max-width: 960px) 46vw, 360px"
            format="webp"
            quality={70}
            loading="lazy"
          />
          {it.cap && <figcaption>{it.cap}</figcaption>}
        </figure>
      ))}
    </div>

    <p class="gl__more" data-reveal>
      <a class="btn btn-ghost" href={`${master.vk}`} target="_blank" rel="noopener">Больше фото в&nbsp;группе ВКонтакте →</a>
    </p>
  </div>
</section>

<style>
  .gl {
    background: var(--bg);
  }
  .gl__cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .gi {
    margin: 0;
    background: #ffffff;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .gi :global(img) {
    width: 100%;
    aspect-ratio: 1 / 1;
    height: auto;
    object-fit: cover;
    display: block;
  }
  .gi figcaption {
    padding: 12px 16px 14px;
    font-size: 14px;
    line-height: 1.45;
    color: var(--ink-muted);
  }
  .gl__more {
    text-align: center;
    margin-top: 24px;
  }
  @media (max-width: 960px) {
    .gl__cols { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .gl__cols { grid-template-columns: 1fr; }
  }
</style>
